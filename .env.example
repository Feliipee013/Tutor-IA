# Copie para .env e ajuste. O .env nao sobe para o Git (ver .gitignore).

# --- Ollama no HOST (consumido pelo `ollama serve`, NAO pelo container) ---
# [OPCIONAL para o compose | OBRIGATORIO para o host]
# O bind padrao do Ollama e 127.0.0.1 e o container chega no IP da bridge do
# Docker, nao no loopback. Sem isto o servico falha alto com "Connection
# refused". Defina no shell ANTES de subir o Ollama:
#   export OLLAMA_HOST=0.0.0.0:11434
#   ollama serve

# --- VRAM da maquina ---
# [OBRIGATORIO, a nao ser em dev/CI com OLLAMA_ALLOW_CPU=true]
# Confronta o size_vram que o Ollama reporta com o que a maquina tem.
#   nvidia-smi --query-gpu=memory.total --format=csv,noheader,nounits
VRAM_TOTAL_MIB=4096

# --- Servico do bot (todas opcionais: ja tem padrao seguro no compose) ---
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=30
OLLAMA_ALLOW_CPU=false
BOT_PORT=8000
LOG_LEVEL=INFO
